rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function callerRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // Prescription slips live under the uploading patient's own uid.
    match /prescriptions/{ownerUid}/{slipFile} {
      allow write: if request.auth != null && request.auth.uid == ownerUid;
      allow read: if request.auth != null && (
        request.auth.uid == ownerUid ||
        callerRole() in ['admin', 'pharmacist']
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
